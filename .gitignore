.DS_Store

# Status line runtime state. Lives under ~/.claude, never here, but guard
# against it landing in the repo if ~/.claude is ever pointed at this checkout.
statusline-limits.json
statusline-limits.json.*
.cache/
ccusage-*.json

# Aurora: engine-written mod types and any stray HUD build output
.claude-plugin/types/
aurora-usage/aurora-hud/AuroraHUD

# setup.sh backups
*.bak.*

# Secrets. Nothing secret-shaped should ever land in a public config repo.
.env
.env.*
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
